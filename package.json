{
	"name": "tanstack-fullstack-template",
	"private": true,
	"type": "module",
	"version": "0.1.0",
	"scripts": {
		"dev": "NODE_OPTIONS='--import tsx --import ./instrument.server.mts' vite dev --port 3000",
		"build": "vite build && tsc -p tsconfig.instrument.json && cp package.json .output/server/package.json",
		"start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
		"preview": "vite preview",
		"test": "vitest run",
		"test:skills": "vitest run scripts/skills/validateSkills.test.ts scripts/skills/runWazaCheck.test.ts",
		"test:skill-evals": "vitest run scripts/skills/skillEvals.test.ts",
		"test:e2e": "playwright test",
		"format": "biome check --write --unsafe",
		"lint": "biome check && pnpm typecheck && pnpm skills:check && pnpm test:skill-evals",
		"typecheck": "tsc --noEmit",
		"skills:check": "node ./scripts/skills/validateSkills.mjs",
		"skills:waza": "node ./scripts/skills/runWazaCheck.mjs"
	},
	"dependencies": {
		"@a2ui-bridge/core": "^0.1.0",
		"@a2ui-bridge/react": "^0.1.0",
		"@mantine/charts": "^9.8.2",
		"@mantine/core": "^9.8.2",
		"@mantine/form": "^9.8.2",
		"@mantine/hooks": "^9.8.2",
		"@mantine/modals": "^9.8.2",
		"@mantine/notifications": "^9.8.2",
		"@sentry/tanstackstart-react": "^11.16.0",
		"@tanstack/ai": "^1.8.0",
		"@tanstack/ai-client": "^1.2.1",
		"@tanstack/ai-gemini": "^1.3.0",
		"@tanstack/ai-mcp": "^1.3.1",
		"@tanstack/ai-openai": "^1.2.0",
		"@tanstack/ai-react": "^1.1.1",
		"@tanstack/react-devtools": "^0.10.15",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-router-devtools": "^1.167.4",
		"@tanstack/react-start": "^1.169.7",
		"dotenv": "^18.0.10",
		"jose": "^6.2.18",
		"lucide-react": "^1.78.0",
		"mongodb": "^7.9.1",
		"nitro": "npm:nitro-nightly@3.0.1-20260410-164248-8ab58a4b",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "^10.1.0",
		"recharts": "^3.11.0",
		"remark-gfm": "^4.0.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@netlify/vite-plugin-tanstack-start": "^1.3.19",
		"@playwright/test": "^1.65.1",
		"@tanstack/devtools-vite": "^0.8.7",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^25.9.9",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"jsdom": "^31.0.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"yaml": "^2.9.1"
	}
}
